    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "csurf": "1.11.0",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "uuid": "10.0.0",
    "winston": "3.14.2",
    "xss-clean": "0.1.4",
    "hpp": "0.2.3"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.4",
    "supertest": "7.0.0",

# ============================================
# Hospital AI Automation Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to source control
# ============================================

# --- Server ---
NODE_ENV=development
DASHBOARD_PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Authentication ---
JWT_SECRET=replace-with-64-char-random-hex-string
SESSION_SECRET=replace-with-64-char-random-hex-string
BCRYPT_ROUNDS=12

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- WhatsApp Business Cloud API ---
WA_VERIFY_TOKEN=your-custom-webhook-verify-token
WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-access-token
WA_APP_SECRET=your-meta-app-secret-for-signature-verification

# --- Voice Calling API ---
VOICE_API_BASE_URL=https://your-voice-api-server.com
VOICE_API_KEY=your-voice-api-key
VOICE_CALLBACK_SECRET=your-voice-callback-hmac-secret

# --- n8n ---
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key

# --- Report Portal ---
REPORT_PORTAL_BASE_URL=https://your-report-portal.com

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_FROM_EMAIL=noreply@yourhospital.com
ADMIN_EMAIL=admin@yourhospital.com

# --- AI ---
GEMINI_API_KEY=your-google-gemini-api-key

# --- Google Review ---
GOOGLE_REVIEW_LINK=https://g.page/your-hospital/review

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
